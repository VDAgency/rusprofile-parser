# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=

# Rusprofile
RUSPROFILE_LOGIN=
RUSPROFILE_PASSWORD=

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_FILE=config/credentials.json
GOOGLE_SHEET_ID=

# OpenAI / OpenRouter (Этап 2)
AI_PROVIDER=openai                     # openai | openrouter
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL_EXTRACT=gpt-4o-mini           # Stage A — извлечение профиля
AI_MODEL_QUALIFY=gpt-4o-mini           # Stage 3 — оценка компании
AI_MAX_TOKENS_EXTRACT=1500
AI_MAX_TOKENS_QUALIFY=400
AI_TEMPERATURE=0.2

# Промпты
AI_PROMPT_EXTRACT_FILE=config/prompts/extract_profile.txt
AI_PROMPT_QUALIFY_FILE=config/prompts/qualify_company.txt

# Stage 2 — пороги keyword-скоринга
KW_HOT_MIN=3
KW_COLD_MIN=2

# Stage 1 — извлечение сайтов
WEBSITE_TIMEOUT_S=15
WEBSITE_MAX_PAGES=3
WEBSITE_MAX_CHARS=12000

# Stage E — кросс-обогащение
CROSS_ENRICH_CONCURRENCY=2
CROSS_ENRICH_TIMEOUT_S=30
CROSS_ENRICH_TTL_DAYS=30
CROSS_ENRICH_NAME_SIMILARITY_THRESHOLD=0.80

# Параллелизм
QUALIFY_WEBSITE_CONCURRENCY=3
QUALIFY_LLM_CONCURRENCY=5
QUALIFY_MAX_COMPANIES_PER_RUN=300

# Тарифы (defaults для новых тенантов)
DEFAULT_TARIFF_PLAN=simple
DEFAULT_AI_QUOTA_COMPANIES=1000
DEFAULT_AI_QUOTA_TOKENS=10000000
TARIFF_PERIOD_DAYS=30

# Стоимость для расчёта (₽ за 1k токенов)
AI_COST_PER_1K_INPUT_RUB=0.015
AI_COST_PER_1K_OUTPUT_RUB=0.06

# Я.Карты — авторизация (для парсинга даты отзывов и operating_status)
YANDEX_LOGIN=
YANDEX_PASSWORD=
YANDEX_SESSION_PATH=config/yandex_session.json

# Прокси для Яндекс-парсера (опционально; пустые — парсим без прокси).
# Формат: http://user:pass@host:port или http://host:port + отдельные USERNAME/PASSWORD.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
